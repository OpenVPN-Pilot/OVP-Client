<?xml version="1.0" encoding="utf-8"?>

<!--
  The installer.

  Three things had to be true for this to be something a person can install rather than a folder they
  are handed: the application has to appear in the Start menu, it has to be removable from the usual
  place, and ovp has to work in any terminal without anyone editing an environment variable by hand.
  An MSI gives the first two for nothing and the third with one component.

  It installs for the machine rather than for one user, because the directory sits under Program
  Files and the PATH entry is a machine wide one. Everything the application writes still belongs to
  the user who runs it: the profile store, the settings and the protected credentials stay under
  their own application data.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="OpenVPN Pilot"
           Manufacturer="Schecher_1"
           Version="$(var.ProductVersion)"
           UpgradeCode="8f1c4a52-6d2e-4a1b-9a3f-2c5d7e8b4016"
           Scope="perMachine"
           Compressed="yes"
           InstallerVersion="500">

    <SummaryInformation Description="OpenVPN Pilot, a desktop client for OpenVPN" />

    <!-- Installing a newer version replaces the old one rather than sitting beside it. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Launch Condition="VersionNT64"
            Message="[ProductName] runs on 64 bit Windows only." />

    <!-- The icon is taken from the executable, so there is no second copy of it to keep in step. -->
    <Icon Id="OpenVpnPilot.exe" SourceFile="$(var.PublishDir)\OpenVpnPilot.exe" />
    <Property Id="ARPPRODUCTICON" Value="OpenVpnPilot.exe" />

    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseFile)" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="OpenVpnPilot" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="OpenVPN Pilot" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="CommandOnPath" />
      <ComponentRef Id="FileTypes" />
    </Feature>

    <!--
      Everything the publish step produced, which is the application, the ovp command and the
      language files they share. Listing them by hand would go stale the first time a dependency
      changed.
    -->
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <!--
      The shortcut carries the application user model identity the process declares for itself. That
      is what lets Windows attribute a notification to an installed application rather than to a
      generated identifier, and the two must therefore say exactly the same thing.
    -->
    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="1a7b9c30-5e84-42d7-b1f6-9c0a3d5e7f21">
      <Shortcut Id="ApplicationShortcut"
                Name="OpenVPN Pilot"
                Description="Manage and connect OpenVPN profiles"
                Target="[INSTALLFOLDER]OpenVpnPilot.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="OpenVpnPilot.exe">
        <ShortcutProperty Key="System.AppUserModel.ID" Value="OpenVpnPilot" />
      </Shortcut>
      <RegistryValue Root="HKLM" Key="Software\OpenVpnPilot" Name="StartMenu"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!--
      File types.

      A configuration is offered rather than claimed. The OpenVPN GUI installs itself as the handler
      for .ovpn and a great many people want it to stay that way, so this writes a program identifier
      and adds it to OpenWithProgids, which puts the application in the Open with list and leaves the
      default alone. Windows 10 and later would not let an installer take the default silently in any
      case; it asks the user once, which is the right person to ask.

      A package is a different matter. The .ovppkg format belongs to this application and nothing
      else reads it, so that one is claimed outright.
    -->
    <Component Id="FileTypes" Directory="INSTALLFOLDER" Guid="2e5a17b8-9c34-4f61-8b0d-6a7e1f2c94d5">
      <RegistryValue Root="HKLM" Key="Software\Classes\OpenVpnPilot.ovpn"
                     Value="OpenVPN configuration" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\Classes\OpenVpnPilot.ovpn\DefaultIcon"
                     Value="[INSTALLFOLDER]OpenVpnPilot.exe,0" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\Classes\OpenVpnPilot.ovpn\shell\open"
                     Value="Import with OpenVPN Pilot" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\Classes\OpenVpnPilot.ovpn\shell\open\command"
                     Value="&quot;[INSTALLFOLDER]OpenVpnPilot.exe&quot; &quot;%1&quot;" Type="string" />

      <!-- Offered, not taken: the default value of the extension key is deliberately not written. -->
      <RegistryValue Root="HKLM" Key="Software\Classes\.ovpn\OpenWithProgids"
                     Name="OpenVpnPilot.ovpn" Value="" Type="string" />

      <RegistryValue Root="HKLM" Key="Software\Classes\OpenVpnPilot.ovppkg"
                     Value="OpenVPN Pilot profile package" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\Classes\OpenVpnPilot.ovppkg\DefaultIcon"
                     Value="[INSTALLFOLDER]OpenVpnPilot.exe,0" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\Classes\OpenVpnPilot.ovppkg\shell\open"
                     Value="Import with OpenVPN Pilot" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\Classes\OpenVpnPilot.ovppkg\shell\open\command"
                     Value="&quot;[INSTALLFOLDER]OpenVpnPilot.exe&quot; &quot;%1&quot;" Type="string" />

      <RegistryValue Root="HKLM" Key="Software\Classes\.ovppkg"
                     Value="OpenVpnPilot.ovppkg" Type="string" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="Software\Classes\.ovppkg\OpenWithProgids"
                     Name="OpenVpnPilot.ovppkg" Value="" Type="string" />
    </Component>

    <!--
      Puts the installation directory on the machine PATH so that ovp works in any terminal. The
      entry is removed again when the product is, which is why it is a component of its own rather
      than something a custom action writes.
    -->
    <Component Id="CommandOnPath" Directory="INSTALLFOLDER" Guid="6c2f8d14-3b95-4e60-8d27-4a1e9f0b5c38">
      <Environment Id="OvpOnPath" Name="PATH" Value="[INSTALLFOLDER]"
                   Part="last" Action="set" System="yes" Permanent="no" />
      <RegistryValue Root="HKLM" Key="Software\OpenVpnPilot" Name="Path"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

  </Package>
</Wix>
