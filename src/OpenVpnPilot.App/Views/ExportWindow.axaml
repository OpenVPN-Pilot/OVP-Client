<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenVpnPilot.App.ViewModels"
        xmlns:loc="using:OpenVpnPilot.App.Localization"
        x:Class="OpenVpnPilot.App.Views.ExportWindow"
        x:DataType="vm:ExportViewModel"
        Width="760" Height="760"
        MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceWindow}"
        Icon="/Assets/openvpnpilot.ico"
        Title="{loc:Translate export.title}">

  <Grid RowDefinitions="Auto,*,Auto,Auto">

    <Border Grid.Row="0" Background="{DynamicResource SurfaceSidebar}"
            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
            Padding="16,12">
      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="18">
          <RadioButton GroupName="Format" IsChecked="{Binding ExportAsPackage}"
                       Content="{loc:Translate export.asPackage}" />
          <RadioButton GroupName="Format" IsChecked="{Binding !ExportAsPackage}"
                       Content="{loc:Translate export.asConfigurations}" />
        </StackPanel>

        <TextBlock Classes="muted" TextWrapping="Wrap"
                   IsVisible="{Binding IsPackage}"
                   Text="{loc:Translate export.packageHint}" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Foreground="{DynamicResource StatePending}"
                   IsVisible="{Binding !IsPackage}"
                   Text="{loc:Translate export.configurationsHint}" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" RowDefinitions="Auto,*">

      <!-- A whole tag at a time, which is how a set is usually handed over. -->
      <StackPanel Grid.Row="0" Margin="16,12,16,0" Spacing="6" IsVisible="{Binding HasTags}">
        <TextBlock Text="{loc:Translate export.byTag}" Classes="overline" />
        <ItemsControl ItemsSource="{Binding Tags}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TagChoiceViewModel">
              <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Classes="divider" />
      </StackPanel>

      <ScrollViewer Grid.Row="1">
        <ItemsControl ItemsSource="{Binding Profiles}" Margin="16,8,16,12">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ExportProfileViewModel">
              <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding TagsDisplay}" Classes="muted" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextTertiary}"
                             IsVisible="{Binding HasTags}" />
                </StackPanel>
              </CheckBox>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0"
            Padding="16,12">
      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{loc:Translate export.selectAll}" Classes="quiet"
                  Command="{Binding SelectAllCommand}" />
          <Button Content="{loc:Translate export.selectNone}" Classes="quiet"
                  Command="{Binding SelectNoneCommand}" />
          <TextBlock Text="{Binding SelectionSummary}" Classes="muted" VerticalAlignment="Center" />
        </StackPanel>

        <!-- What else a package carries. Plain configurations are only ever the configurations. -->
        <StackPanel Spacing="4" IsVisible="{Binding IsPackage}">
          <CheckBox Content="{loc:Translate export.includeHotkeys}" IsChecked="{Binding IncludeHotkeys}" />
          <CheckBox Content="{loc:Translate export.includeSettings}" IsChecked="{Binding IncludeSettings}" />
          <TextBlock Text="{loc:Translate export.includeSettingsHint}" Classes="muted" TextWrapping="Wrap"
                     IsVisible="{Binding IncludeSettings}" />
        </StackPanel>

        <StackPanel Spacing="6" IsVisible="{Binding CanIncludeCredentials}">
          <CheckBox Content="{loc:Translate export.includeCredentials}"
                    IsChecked="{Binding IncludeCredentials}"
                    IsEnabled="{Binding HasCredentials}" />
          <TextBlock Text="{Binding CredentialSummary}" Classes="muted" TextWrapping="Wrap" />
          <Border CornerRadius="7" Padding="12,10"
                  Background="{DynamicResource StatePendingSoft}"
                  IsVisible="{Binding IncludeCredentials}">
            <TextBlock TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource StatePending}"
                       Text="{loc:Translate export.credentialsWarning}" />
          </Border>
        </StackPanel>

        <StackPanel Spacing="6" IsVisible="{Binding IsPackage}">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="{loc:Translate export.passphrase}" Classes="muted" />
              <TextBox Text="{Binding Passphrase}" PasswordChar="•" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="{loc:Translate export.passphraseAgain}" Classes="muted" />
              <TextBox Text="{Binding PassphraseConfirmation}" PasswordChar="•" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding PassphraseProblem}" FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource StateFailed}"
                     IsVisible="{Binding HasPassphraseProblem}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="3" Background="{DynamicResource SurfaceSidebar}"
            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0"
            Padding="16,12">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Classes="muted"
                   VerticalAlignment="Center" TextWrapping="Wrap" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="{loc:Translate common.cancel}" MinWidth="96" IsCancel="True"
                  Command="{Binding CancelCommand}" />
          <Button Name="ExportButton" Content="{loc:Translate export.write}"
                  Classes="primary" MinWidth="120" IsDefault="True"
                  IsEnabled="{Binding CanExport}" />
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</Window>
