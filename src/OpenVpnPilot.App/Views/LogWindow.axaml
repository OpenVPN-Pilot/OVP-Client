<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenVpnPilot.App.ViewModels"
        xmlns:conv="using:OpenVpnPilot.App.Converters"
        xmlns:loc="using:OpenVpnPilot.App.Localization"
        x:Class="OpenVpnPilot.App.Views.LogWindow"
        x:DataType="vm:LogViewModel"
        Width="1000" Height="640"
        MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceWindow}"
        Icon="/Assets/openvpnpilot.ico"
        Title="{loc:Translate log.title}">

  <Grid RowDefinitions="Auto,*,Auto">

    <!--
      Both streams in one list, with a filter rather than two views. What a log is read for is the
      moment where one of them explains the other.
    -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceSidebar}"
            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
            Padding="16,12">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
        <ComboBox Grid.Column="0" ItemsSource="{Binding Sources}"
                  SelectedItem="{Binding SelectedSource}" MinWidth="170">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LogSourceChoice">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <ComboBox Grid.Column="1" ItemsSource="{Binding Levels}"
                  SelectedItem="{Binding SelectedLevel}" MinWidth="150">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LogLevelChoice">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBox Grid.Column="2" Text="{Binding SearchTerm}" MinWidth="0"
                 PlaceholderText="{loc:Translate log.search}" />

        <CheckBox Grid.Column="3" IsChecked="{Binding FollowsTail}"
                  Content="{loc:Translate log.follow}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <ScrollViewer Name="Scroller" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Rows}" Margin="16,10">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LogRowViewModel">
              <Grid ColumnDefinitions="86,64,150,*" ColumnSpacing="10" Margin="0,0,0,2">
                <TextBlock Grid.Column="0" Text="{Binding TimeDisplay}"
                           FontFamily="Consolas,Menlo,monospace" FontSize="11.5"
                           Foreground="{DynamicResource TextTertiary}" />
                <TextBlock Grid.Column="1" Text="{Binding SourceDisplay}"
                           FontFamily="Consolas,Menlo,monospace" FontSize="11.5"
                           Foreground="{DynamicResource TextTertiary}" />
                <TextBlock Grid.Column="2" Text="{Binding ScopeDisplay}"
                           FontFamily="Consolas,Menlo,monospace" FontSize="11.5"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding ScopeDisplay}"
                           Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Grid.Column="3" Text="{Binding Message}"
                           FontFamily="Consolas,Menlo,monospace" FontSize="11.5"
                           TextWrapping="Wrap"
                           Foreground="{Binding Level, Converter={x:Static conv:AppConverters.LogLevelBrush}}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <TextBlock Text="{Binding EmptyText}" Classes="muted" TextWrapping="Wrap" MaxWidth="420"
                 TextAlignment="Center"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding !HasRows}" />
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource SurfaceSidebar}"
            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0"
            Padding="16,12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusMessage}" Classes="body"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{loc:Translate log.retentionHint}" Classes="muted"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="{loc:Translate log.clearView}" Classes="quiet"
                  Command="{Binding ClearViewCommand}" />
          <Button Name="OpenFolderButton" Content="{loc:Translate log.openFolder}" Classes="quiet" />
          <Button Name="SaveButton" Content="{loc:Translate log.save}" MinWidth="110" />
          <Button Name="CloseButton" Content="{loc:Translate common.close}" MinWidth="96" IsCancel="True" />
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</Window>
