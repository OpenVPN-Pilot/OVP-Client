<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenVpnPilot.App.ViewModels"
        xmlns:loc="using:OpenVpnPilot.App.Localization"
        x:Class="OpenVpnPilot.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Width="760" Height="680"
        MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceWindow}"
        Icon="/Assets/openvpnpilot.ico"
        Title="{loc:Translate header.settings}">

  <Grid RowDefinitions="*,Auto">

    <TabControl Grid.Row="0" Margin="12,10">

      <!-- General -->
      <TabItem Header="{loc:Translate settings.tabGeneral}">
        <ScrollViewer>
          <StackPanel Margin="16" Spacing="14">

            <TextBlock Text="{loc:Translate settings.language}" Classes="section" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                        MinWidth="240">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LanguageChoice">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Content="{loc:Translate settings.reloadLanguages}" Classes="quiet"
                      Command="{Binding ReloadLanguagesCommand}" />
            </StackPanel>
            <TextBlock Text="{loc:Translate settings.languageHint}" Classes="muted"
                       TextWrapping="Wrap" />

            <Border Classes="divider" />

            <TextBlock Text="{loc:Translate settings.appearance}" Classes="section" />
            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                      MinWidth="240" HorizontalAlignment="Left">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ThemeChoice">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <Border Classes="divider" />

            <TextBlock Text="{loc:Translate settings.startup}" Classes="section" />
            <CheckBox Content="{loc:Translate settings.startWithSystem}"
                      IsChecked="{Binding StartWithSystem}"
                      IsEnabled="{Binding AutoStartAvailable}" />
            <CheckBox Content="{loc:Translate settings.startMinimised}"
                      IsChecked="{Binding StartMinimised}" />
            <CheckBox Content="{loc:Translate settings.closeToTray}"
                      IsChecked="{Binding CloseToTray}" />

            <Border Classes="divider" />

            <TextBlock Text="{loc:Translate settings.profileEditor}" Classes="section" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{loc:Translate settings.profileEditorOpens}" Classes="muted"
                         VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding EditorViews}" SelectedItem="{Binding SelectedEditorView}"
                        MinWidth="240">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:EditorViewChoice">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <TextBlock Text="{loc:Translate settings.profileEditorHint}" Classes="muted"
                       TextWrapping="Wrap" />

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Connections -->
      <TabItem Header="{loc:Translate settings.tabConnections}">
        <ScrollViewer>
          <StackPanel Margin="16" Spacing="14">

            <TextBlock Text="{loc:Translate settings.routing}" Classes="section" />
            <CheckBox Content="{loc:Translate settings.protectRoutes}"
                      IsChecked="{Binding ProtectRoutes}" />
            <TextBlock Text="{loc:Translate settings.protectRoutesHint}" Classes="muted"
                       TextWrapping="Wrap" />

            <Border Classes="divider" />

            <TextBlock Text="{loc:Translate settings.reconnect}" Classes="section" />
            <CheckBox Content="{loc:Translate settings.autoReconnect}"
                      IsChecked="{Binding AutoReconnect}" />

            <Grid ColumnDefinitions="220,140" RowDefinitions="Auto,Auto,Auto" >
              <TextBlock Grid.Row="0" Grid.Column="0" Classes="muted" VerticalAlignment="Center"
                         Text="{loc:Translate settings.maxAttempts}" />
              <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Increment="1"
                             FormatString="0" Value="{Binding MaxReconnectAttempts}" />

              <TextBlock Grid.Row="1" Grid.Column="0" Classes="muted" VerticalAlignment="Center"
                         Margin="0,8,0,0" Text="{loc:Translate settings.reconnectDelay}" />
              <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="600" Increment="1"
                             Margin="0,8,0,0" FormatString="0" Value="{Binding ReconnectDelaySeconds}" />

              <TextBlock Grid.Row="2" Grid.Column="0" Classes="muted" VerticalAlignment="Center"
                         Margin="0,8,0,0" Text="{loc:Translate settings.connectTimeout}" />
              <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="5" Maximum="600" Increment="5"
                             Margin="0,8,0,0" FormatString="0" Value="{Binding ConnectTimeoutSeconds}" />
            </Grid>

            <TextBlock Text="{loc:Translate settings.maxAttemptsHint}" Classes="muted"
                       TextWrapping="Wrap" />

            <CheckBox Content="{loc:Translate settings.restoreOnStart}"
                      IsChecked="{Binding RestoreOnStart}" />

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Shortcuts -->
      <TabItem Header="{loc:Translate settings.tabHotkeys}">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Margin="16,14,16,6" Classes="muted" TextWrapping="Wrap"
                     Text="{loc:Translate settings.hotkeyHint}" />

          <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Hotkeys}" Margin="16,0,16,16">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HotkeyEditorViewModel">
                  <Grid ColumnDefinitions="*,190,Auto,Auto" Margin="0,3">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding DisplayName}" Classes="body" />
                      <TextBlock Text="{Binding Problem}" FontSize="11"
                                 Foreground="{DynamicResource StateFailed}"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding HasProblem}" />
                    </StackPanel>

                    <Border Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Background="{DynamicResource SurfaceInput}"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="1" Padding="10,7">
                      <TextBlock Text="{Binding GestureDisplay}" FontSize="12.5"
                                 Foreground="{DynamicResource TextPrimary}" />
                    </Border>

                    <Button Grid.Column="2" Classes="quiet" VerticalAlignment="Center"
                            Content="{loc:Translate settings.record}"
                            Command="{Binding StartRecordingCommand}" />
                    <Button Grid.Column="3" Classes="quiet" VerticalAlignment="Center"
                            Content="{loc:Translate common.clear}"
                            Command="{Binding ClearCommand}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- Notifications -->
      <TabItem Header="{loc:Translate settings.tabNotifications}">
        <ScrollViewer>
          <StackPanel Margin="16" Spacing="12">
            <CheckBox Content="{loc:Translate settings.notificationsEnabled}"
                      IsChecked="{Binding NotificationsEnabled}" />
            <Border Classes="divider" />
            <CheckBox Content="{loc:Translate settings.notifyConnecting}"
                      IsChecked="{Binding NotifyOnConnecting}"
                      IsEnabled="{Binding NotificationsEnabled}" />
            <CheckBox Content="{loc:Translate settings.notifyConnected}"
                      IsChecked="{Binding NotifyOnConnected}"
                      IsEnabled="{Binding NotificationsEnabled}" />
            <CheckBox Content="{loc:Translate settings.notifyDisconnected}"
                      IsChecked="{Binding NotifyOnDisconnected}"
                      IsEnabled="{Binding NotificationsEnabled}" />
            <CheckBox Content="{loc:Translate settings.notifyConnectionLost}"
                      IsChecked="{Binding NotifyOnConnectionLost}"
                      IsEnabled="{Binding NotificationsEnabled}" />
            <CheckBox Content="{loc:Translate settings.notifyReconnecting}"
                      IsChecked="{Binding NotifyOnReconnecting}"
                      IsEnabled="{Binding NotificationsEnabled}" />
            <CheckBox Content="{loc:Translate settings.notifyFailed}"
                      IsChecked="{Binding NotifyOnFailed}"
                      IsEnabled="{Binding NotificationsEnabled}" />
            <TextBlock Text="{loc:Translate settings.notificationsHint}" Classes="muted"
                       TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Credentials -->
      <TabItem Header="{loc:Translate settings.tabCredentials}">
        <ScrollViewer>
          <StackPanel Margin="16" Spacing="12">
            <CheckBox Content="{loc:Translate settings.useStoredSecrets}"
                      IsChecked="{Binding UseStoredSecrets}"
                      IsEnabled="{Binding SecretsAvailable}" />
            <CheckBox Content="{loc:Translate settings.rememberByDefault}"
                      IsChecked="{Binding RememberByDefault}"
                      IsEnabled="{Binding SecretsAvailable}" />
            <TextBlock Text="{loc:Translate settings.credentialsHint}" Classes="muted"
                       TextWrapping="Wrap" />
            <Border Classes="divider" />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Classes="body" VerticalAlignment="Center"
                         Text="{Binding StoredSecretCount, StringFormat={}{0}}" />
              <Button Content="{loc:Translate settings.forgetCredentials}"
                      Command="{Binding ForgetStoredCredentialsCommand}" />
            </StackPanel>
            <!-- A shared library carries the sign ins, so forgetting them is a change every machine takes. -->
            <TextBlock Text="{loc:Translate settings.credentialsShared}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource StatePending}"
                       IsVisible="{Binding IsLibraryShared}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!--
        Profiles: everything about getting configurations into the store and back out of it. The
        import and export screens are reached from here rather than from the main window, so the
        header carries only what is used while tunnels are running.
      -->
      <TabItem Header="{loc:Translate settings.tabProfiles}">
        <ScrollViewer>
          <StackPanel Margin="16,14,16,16" Spacing="10">
            <TextBlock Text="{loc:Translate settings.transfer}" Classes="section" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{loc:Translate header.import}"
                      Command="{Binding OpenImportCommand}" />
              <Button Content="{loc:Translate header.export}"
                      Command="{Binding OpenExportCommand}" />
              <Button Content="{loc:Translate settings.reloadProfiles}" Classes="quiet"
                      Command="{Binding ReloadProfilesCommand}" />
            </StackPanel>
            <TextBlock Text="{loc:Translate settings.transferHint}" Classes="muted"
                       TextWrapping="Wrap" />
            <TextBlock Text="{loc:Translate settings.reloadProfilesHint}" Classes="muted"
                       TextWrapping="Wrap" />

            <Border Classes="divider" />

            <!--
              A shared library is changed at once rather than with the settings' own save button:
              joining, creating and leaving each reach a file other machines use, and a choice that
              only took effect on save could be abandoned by closing the window after it had.
            -->
            <TextBlock Text="{loc:Translate library.section}" Classes="section" />
            <TextBlock Text="{loc:Translate library.hint}" Classes="muted" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsLibraryShared}">
              <Button Name="JoinLibraryButton" Content="{loc:Translate library.join}"
                      IsEnabled="{Binding !IsLibraryBusy}" />
              <Button Name="CreateLibraryButton" Content="{loc:Translate library.create}"
                      IsEnabled="{Binding !IsLibraryBusy}" />
            </StackPanel>

            <!--
              Joining replaces the profiles on this machine. Asked here rather than in a dialog, so
              that exporting them first opens the ordinary export screen with nothing in its way.
            -->
            <Border CornerRadius="7" Padding="12,10"
                    Background="{DynamicResource StatePendingSoft}"
                    IsVisible="{Binding IsConfirmingJoin}">
              <StackPanel Spacing="9">
                <TextBlock Text="{Binding JoinWarning}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextPrimary}" />
                <CheckBox Content="{loc:Translate library.joinAcknowledge}"
                          IsChecked="{Binding JoinAcknowledged}" />
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Button Grid.Column="0" Content="{loc:Translate library.exportFirst}"
                          Command="{Binding OpenExportCommand}" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="{loc:Translate common.cancel}" Classes="quiet"
                            Command="{Binding CancelJoinLibraryCommand}" />
                    <Button Name="ContinueJoinButton" Content="{loc:Translate library.continueJoin}"
                            Classes="primary"
                            IsEnabled="{Binding JoinAcknowledged}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <StackPanel Spacing="8" IsVisible="{Binding IsLibraryShared}">
              <SelectableTextBlock Text="{Binding LibraryPath}" FontSize="13" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimary}" />
              <TextBlock Text="{Binding LibraryStatusText}" Classes="muted" TextWrapping="Wrap" />
              <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8"
                         IsVisible="{Binding !IsConfirmingLeave}">
                <Button Content="{loc:Translate library.syncNow}" Classes="primary"
                        IsEnabled="{Binding !IsLibraryBusy}"
                        Command="{Binding SyncLibraryNowCommand}" />
                <Button Name="LibraryPassphraseButton" Content="{Binding LibraryPassphraseLabel}"
                        IsEnabled="{Binding !IsLibraryBusy}" />
                <Button Content="{loc:Translate library.leave}" Classes="danger"
                        IsEnabled="{Binding !IsLibraryBusy}"
                        Command="{Binding AskToLeaveLibraryCommand}" />
              </WrapPanel>
              <Border CornerRadius="7" Padding="12,10"
                      Background="{DynamicResource StateFailedSoft}"
                      IsVisible="{Binding IsConfirmingLeave}">
                <StackPanel Spacing="9">
                  <TextBlock Text="{loc:Translate library.leaveConfirm}" TextWrapping="Wrap" FontSize="12"
                             Foreground="{DynamicResource TextPrimary}" />
                  <RadioButton GroupName="LeaveLibrary" Content="{loc:Translate library.leaveKeep}"
                               IsChecked="{Binding LeaveKeepsProfiles}" />
                  <RadioButton GroupName="LeaveLibrary" Content="{loc:Translate library.leaveRemove}"
                               IsChecked="{Binding LeaveRemovesProfiles}" />
                  <TextBlock Text="{loc:Translate library.leaveRemoveWarning}" TextWrapping="Wrap" FontSize="12"
                             Foreground="{DynamicResource StateFailed}"
                             IsVisible="{Binding LeaveRemovesProfiles}" />
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Grid.Column="0" Content="{loc:Translate library.exportFirst}"
                            IsVisible="{Binding LeaveRemovesProfiles}"
                            Command="{Binding OpenExportCommand}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                      <Button Content="{loc:Translate common.cancel}" Classes="quiet"
                              Command="{Binding CancelLeaveLibraryCommand}" />
                      <Button Content="{loc:Translate library.leave}" Classes="destructive"
                              IsEnabled="{Binding CanLeave}"
                              Command="{Binding LeaveLibraryCommand}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Advanced -->
      <TabItem Header="{loc:Translate settings.tabAdvanced}">
        <ScrollViewer>
          <StackPanel Margin="16" Spacing="12">

            <TextBlock Text="{loc:Translate settings.openVpnPath}" Classes="muted" />
            <TextBox Text="{Binding OpenVpnPath}"
                     PlaceholderText="{loc:Translate settings.openVpnPathHint}" />

            <Grid ColumnDefinitions="220,140">
              <TextBlock Grid.Column="0" Classes="muted" VerticalAlignment="Center"
                         Text="{loc:Translate settings.verbosity}" />
              <NumericUpDown Grid.Column="1" Minimum="0" Maximum="11" Increment="1"
                             FormatString="0" Value="{Binding OpenVpnVerbosity}" />
            </Grid>

            <StackPanel Spacing="6">
              <TextBlock Text="{loc:Translate settings.logLevel}" Classes="muted" />
              <ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}"
                        MinWidth="200" HorizontalAlignment="Left" />
            </StackPanel>

            <Grid ColumnDefinitions="220,140">
              <TextBlock Grid.Column="0" Classes="muted" VerticalAlignment="Center"
                         TextWrapping="Wrap"
                         Text="{loc:Translate settings.logRetention}" />
              <NumericUpDown Grid.Column="1" Minimum="0" Maximum="365" Increment="1"
                             FormatString="0" Value="{Binding LogRetentionDays}" />
            </Grid>
            <Grid ColumnDefinitions="220,140">
              <TextBlock Grid.Column="0" Classes="muted" VerticalAlignment="Center"
                         TextWrapping="Wrap"
                         Text="{loc:Translate settings.logMaximum}" />
              <NumericUpDown Grid.Column="1" Minimum="0" Maximum="100000" Increment="100"
                             FormatString="0" Value="{Binding LogMaximumMegabytes}" />
            </Grid>
            <TextBlock Text="{loc:Translate settings.logRetentionHint}" Classes="muted"
                       TextWrapping="Wrap" />

            <Border Classes="divider" />

            <!--
              What is contacted is named here rather than left to be discovered. The check is the
              only thing in the application that talks to a network the user did not ask for.
            -->
            <CheckBox Content="{loc:Translate settings.checkForUpdates}"
                      IsChecked="{Binding CheckForUpdates}" />
            <TextBlock Text="{loc:Translate settings.checkForUpdatesHint}" Classes="muted"
                       TextWrapping="Wrap" />

            <StackPanel Spacing="6">
              <TextBlock Text="{loc:Translate settings.updateRepository}" Classes="muted" />
              <TextBox Text="{Binding UpdateRepository}"
                       PlaceholderText="{loc:Translate settings.updateRepositoryHint}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{loc:Translate settings.checkNow}"
                      Command="{Binding CheckForUpdatesNowCommand}" />
              <TextBlock Text="{Binding UpdateStatus}" Classes="muted" TextWrapping="Wrap"
                         VerticalAlignment="Center" />
            </StackPanel>

            <Border Classes="divider" />

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{loc:Translate settings.clearHistory}"
                      Command="{Binding ClearHistoryCommand}" />
              <Button Name="DiagnosticsButton" Content="{loc:Translate settings.diagnostics}" />
            </StackPanel>
            <TextBlock Text="{loc:Translate settings.diagnosticsHint}" Classes="muted"
                       TextWrapping="Wrap" />
            <Border CornerRadius="7" Padding="12,10"
                    Background="{DynamicResource StatePendingSoft}">
              <TextBlock TextWrapping="Wrap" FontSize="12"
                         Foreground="{DynamicResource StatePending}"
                         Text="{loc:Translate settings.diagnosticsPrivacy}" />
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>

    <Border Grid.Row="1" Background="{DynamicResource SurfaceSidebar}"
            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0"
            Padding="16,12">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Classes="muted"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <!--
            Return saves and escape closes, from any field. A shortcut being recorded takes the key
            before either button sees it, so return and escape can still be recorded or cancelled.
          -->
          <Button Content="{loc:Translate common.cancel}" MinWidth="96" IsCancel="True"
                  Command="{Binding CancelCommand}" />
          <Button Content="{loc:Translate common.save}" Classes="primary" MinWidth="96" IsDefault="True"
                  Command="{Binding SaveCommand}" />
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</Window>
