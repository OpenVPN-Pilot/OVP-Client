<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenVpnPilot.App.ViewModels"
        xmlns:conv="using:OpenVpnPilot.App.Converters"
        xmlns:loc="using:OpenVpnPilot.App.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="720"
        x:Class="OpenVpnPilot.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1180" Height="720"
        MinWidth="920" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceWindow}"
        Icon="/Assets/openvpnpilot.ico"
        Title="OpenVpnPilot">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Header: identity on the left, search in the middle, actions on the right. -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceSidebar}"
            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
            Padding="18,13">
      <Grid ColumnDefinitions="Auto,*,Auto">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="22" Height="22" CornerRadius="11"
                  Background="{DynamicResource Accent}" VerticalAlignment="Center">
            <Border Width="8" Height="8" CornerRadius="4"
                    Background="{DynamicResource SurfaceSidebar}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{loc:Translate app.name}" FontSize="14.5" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
        </StackPanel>

        <TextBox Grid.Column="1" Name="SearchBox"
                 PlaceholderText="{loc:Translate header.search}"
                 MaxWidth="440" HorizontalAlignment="Center"
                 Text="{Binding SearchTerm}" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Content="{loc:Translate header.import}" Classes="quiet"
                  Command="{Binding OpenImportCommand}" />
          <Button Content="{loc:Translate nav.history}" Classes="quiet"
                  Command="{Binding OpenHistoryCommand}" />
          <Button Content="{loc:Translate header.settings}" Classes="quiet"
                  Command="{Binding OpenSettingsCommand}" />
          <Button Content="{loc:Translate header.refresh}" Classes="quiet"
                  Command="{Binding RefreshCommand}" />
          <Button Content="{loc:Translate header.disconnectAll}"
                  Command="{Binding DisconnectAllCommand}"
                  IsEnabled="{Binding HasActiveConnections}" />
        </StackPanel>

      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="228,*,352">

      <!-- Sidebar -->
      <Border Grid.Column="0" Background="{DynamicResource SurfaceSidebar}"
              BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,1,0">
        <ScrollViewer>
          <StackPanel Margin="12,16" Spacing="18">

            <StackPanel Spacing="6">
              <TextBlock Text="{loc:Translate nav.library}" Classes="overline" Margin="10,0,0,2" />
              <ListBox Classes="nav" ItemsSource="{Binding Filters}"
                       SelectedItem="{Binding SelectedFilter}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SidebarFilterViewModel">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="13"
                                 Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                 Text="{Binding Count, Converter={x:Static conv:AppConverters.CountBadge}}"
                                 FontSize="11" Foreground="{DynamicResource TextTertiary}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding HasFolders}">
              <TextBlock Text="{loc:Translate nav.folders}" Classes="overline" Margin="10,0,0,2" />
              <ListBox Classes="nav" ItemsSource="{Binding FolderFilters}"
                       SelectedItem="{Binding SelectedFilter}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SidebarFilterViewModel">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="13"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                 Text="{Binding Count, Converter={x:Static conv:AppConverters.CountBadge}}"
                                 FontSize="11" Foreground="{DynamicResource TextTertiary}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding HasTags}">
              <TextBlock Text="{loc:Translate nav.tags}" Classes="overline" Margin="10,0,0,2" />
              <ListBox Classes="nav" ItemsSource="{Binding TagFilters}"
                       SelectedItem="{Binding SelectedFilter}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SidebarFilterViewModel">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="13"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                 Text="{Binding Count, Converter={x:Static conv:AppConverters.CountBadge}}"
                                 FontSize="11" Foreground="{DynamicResource TextTertiary}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Profile list -->
      <Grid Grid.Column="1">
        <ListBox Classes="profiles" ItemsSource="{Binding VisibleProfiles}"
                 SelectedItem="{Binding SelectedProfile}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ProfileItemViewModel">
              <Border Padding="14,12" CornerRadius="10" Background="Transparent">
                <Grid ColumnDefinitions="Auto,*,Auto">

                  <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                          Margin="0,0,14,0" VerticalAlignment="Center"
                          Background="{Binding Status.State, Converter={x:Static conv:AppConverters.StateBrush}}" />

                  <StackPanel Grid.Column="1" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimary}"
                                 TextTrimming="CharacterEllipsis" />
                      <Border Classes="slot" IsVisible="{Binding HasFavouriteSlot}">
                        <TextBlock Text="{Binding FavouriteSlotDisplay}" />
                      </Border>
                      <TextBlock Text="*" FontSize="14" VerticalAlignment="Center"
                                 Foreground="{DynamicResource StatePending}"
                                 IsVisible="{Binding IsFavourite}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Endpoint}" Classes="muted" />
                      <TextBlock Text="{Binding TagsDisplay}" Classes="muted"
                                 Foreground="{DynamicResource TextTertiary}"
                                 IsVisible="{Binding HasTags}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </StackPanel>

                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                              VerticalAlignment="Center">
                    <TextBlock Text="!" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource StatePending}"
                               ToolTip.Tip="{loc:Translate profile.unsupportedTooltip}"
                               IsVisible="{Binding HasUnsupportedOptions}" />
                    <Border Classes="pill" IsVisible="{Binding !IsIdle}"
                            Background="{Binding Status.State, Converter={x:Static conv:AppConverters.StatePillBackground}}">
                      <TextBlock Text="{Binding StatusText}"
                                 Foreground="{Binding Status.State, Converter={x:Static conv:AppConverters.StatePillForeground}}" />
                    </Border>
                  </StackPanel>

                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                    MaxWidth="340" IsVisible="{Binding !VisibleProfiles.Count}">
          <TextBlock Text="{Binding EmptyStateTitle}" FontSize="14" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding EmptyStateDetail}" Classes="muted"
                     TextWrapping="Wrap" TextAlignment="Center" />
          <Button Content="{loc:Translate header.import}" Classes="primary"
                  HorizontalAlignment="Center" Margin="0,6,0,0"
                  Command="{Binding OpenImportCommand}" />
        </StackPanel>
      </Grid>

      <!-- Detail -->
      <Border Grid.Column="2" Background="{DynamicResource SurfaceSidebar}"
              BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1,0,0,0">
        <ScrollViewer>
          <StackPanel Margin="20" Spacing="18" IsVisible="{Binding HasSelection}">

            <StackPanel Spacing="8">
              <TextBlock Text="{Binding SelectedProfile.Name}" Classes="title" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding SelectedProfile.Endpoint}" Classes="muted"
                           VerticalAlignment="Center" />
                <Border Classes="pill"
                        Background="{Binding SelectedProfile.Status.State, Converter={x:Static conv:AppConverters.StatePillBackground}}">
                  <TextBlock Text="{Binding SelectedProfile.StatusLabel}"
                             Foreground="{Binding SelectedProfile.Status.State, Converter={x:Static conv:AppConverters.StatePillForeground}}" />
                </Border>
              </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{loc:Translate profile.connect}" Classes="primary" MinWidth="106"
                      IsVisible="{Binding SelectedProfile.IsIdle}"
                      Command="{Binding ConnectCommand}"
                      CommandParameter="{Binding SelectedProfile}" />
              <Button Content="{loc:Translate profile.disconnect}" MinWidth="106"
                      IsVisible="{Binding !SelectedProfile.IsIdle}"
                      Command="{Binding DisconnectCommand}"
                      CommandParameter="{Binding SelectedProfile}" />
              <Button Content="{Binding SelectedProfile.FavouriteActionLabel}" Classes="quiet"
                      Command="{Binding ToggleFavouriteCommand}"
                      CommandParameter="{Binding SelectedProfile}" />
              <Button Content="{loc:Translate profile.edit}" Classes="quiet"
                      Command="{Binding OpenProfileEditorCommand}" />
            </StackPanel>

            <Border Classes="divider" />

            <StackPanel Spacing="14" IsVisible="{Binding SelectedProfile.IsConnected}">
              <Grid ColumnDefinitions="*,*,*">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="{loc:Translate profile.received}" Classes="overline" />
                  <TextBlock Classes="body" FontSize="15" FontWeight="SemiBold"
                             Text="{Binding SelectedProfile.Status.BytesReceived, Converter={x:Static conv:AppConverters.ByteSize}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Text="{loc:Translate profile.sent}" Classes="overline" />
                  <TextBlock Classes="body" FontSize="15" FontWeight="SemiBold"
                             Text="{Binding SelectedProfile.Status.BytesSent, Converter={x:Static conv:AppConverters.ByteSize}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="3">
                  <TextBlock Text="{loc:Translate profile.uptime}" Classes="overline" />
                  <TextBlock Classes="body" FontSize="15" FontWeight="SemiBold"
                             Text="{Binding SelectedProfile.UptimeDisplay}" />
                </StackPanel>
              </Grid>
              <Border Classes="divider" />
            </StackPanel>

            <StackPanel Spacing="11">
              <Grid ColumnDefinitions="104,*">
                <TextBlock Grid.Column="0" Text="{loc:Translate profile.localAddress}" Classes="muted" />
                <TextBlock Grid.Column="1" Classes="body"
                           Text="{Binding SelectedProfile.LocalAddressDisplay}" />
              </Grid>
              <Grid ColumnDefinitions="104,*">
                <TextBlock Grid.Column="0" Text="{loc:Translate profile.server}" Classes="muted" />
                <TextBlock Grid.Column="1" Classes="body"
                           Text="{Binding SelectedProfile.ServerDisplay}" />
              </Grid>
              <Grid ColumnDefinitions="104,*">
                <TextBlock Grid.Column="0" Text="{loc:Translate profile.signIn}" Classes="muted" />
                <TextBlock Grid.Column="1" Classes="body"
                           Text="{Binding SelectedProfile.AuthenticationDisplay}" />
              </Grid>
              <Grid ColumnDefinitions="104,*">
                <TextBlock Grid.Column="0" Text="{loc:Translate profile.lastUsed}" Classes="muted" />
                <TextBlock Grid.Column="1" Classes="body"
                           Text="{Binding SelectedProfile.LastConnectedDisplay}" />
              </Grid>
              <Grid ColumnDefinitions="104,*" IsVisible="{Binding SelectedProfile.HasTags}">
                <TextBlock Grid.Column="0" Text="{loc:Translate nav.tags}" Classes="muted" />
                <TextBlock Grid.Column="1" Classes="body" TextWrapping="Wrap"
                           Text="{Binding SelectedProfile.TagsDisplay}" />
              </Grid>
            </StackPanel>

            <Border CornerRadius="7" Padding="12,10"
                    Background="{DynamicResource StatePendingSoft}"
                    IsVisible="{Binding SelectedProfile.HasUnsupportedOptions}">
              <TextBlock TextWrapping="Wrap" FontSize="12"
                         Foreground="{DynamicResource StatePending}"
                         Text="{loc:Translate profile.unsupportedNotice}" />
            </Border>

            <Border CornerRadius="7" Padding="12,10"
                    Background="{DynamicResource StateFailedSoft}"
                    IsVisible="{Binding SelectedProfile.HasFailureMessage}">
              <TextBlock TextWrapping="Wrap" FontSize="12"
                         Foreground="{DynamicResource StateFailed}"
                         Text="{Binding SelectedProfile.Status.Message}" />
            </Border>

          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2" Background="{DynamicResource SurfaceSidebar}"
            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0"
            Padding="18,8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Classes="muted"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"
                    IsVisible="{Binding HasActiveConnections}">
          <Border Width="7" Height="7" CornerRadius="4" VerticalAlignment="Center"
                  Background="{DynamicResource StateConnected}" />
          <TextBlock Text="{Binding ActiveSummary}" Classes="muted" />
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</Window>
