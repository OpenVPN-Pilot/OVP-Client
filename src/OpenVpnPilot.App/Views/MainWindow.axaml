<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenVpnPilot.App.ViewModels"
        xmlns:conv="using:OpenVpnPilot.App.Converters"
        xmlns:loc="using:OpenVpnPilot.App.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="720"
        x:Class="OpenVpnPilot.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1180" Height="720"
        MinWidth="920" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceWindow}"
        Icon="/Assets/openvpnpilot.ico"
        Title="{loc:Translate app.name}">

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!--
      Header: identity on the left, search in the middle, actions on the right.

      The header is clipped and the search box carries no minimum width, because a star column is
      still measured at its child's minimum size. A minimum wider than the space left over is exactly
      how a control ends up painted over the ones beside it, which is what the search box did to the
      wordmark and the buttons at the smallest window size.
    -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceSidebar}"
            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
            Padding="18,13" ClipToBounds="True">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="22" Height="22" CornerRadius="11"
                  Background="{DynamicResource Accent}" VerticalAlignment="Center">
            <Border Width="14" Height="14" CornerRadius="7"
                    Background="{DynamicResource SurfaceSidebar}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border Width="8" Height="8" CornerRadius="4"
                      Background="{DynamicResource Accent}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Border>
          <TextBlock Text="{loc:Translate app.name}" FontSize="14.5" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
        </StackPanel>

        <TextBox Grid.Column="1" Name="SearchBox"
                 PlaceholderText="{loc:Translate header.search}"
                 MinWidth="0" MaxWidth="460"
                 HorizontalAlignment="Stretch"
                 Text="{Binding SearchTerm}" />

        <!--
          Only what is used while working with tunnels. Importing and exporting are occasional and
          live on the profiles page of the settings screen, so the header stays legible when the
          window is small.
        -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Content="{loc:Translate nav.history}" Classes="quiet"
                  Command="{Binding OpenHistoryCommand}" />
          <Button Content="{loc:Translate nav.log}" Classes="quiet"
                  ToolTip.Tip="{loc:Translate nav.logHint}"
                  Command="{Binding OpenLogCommand}" />
          <Button Content="{loc:Translate header.settings}" Classes="quiet"
                  Command="{Binding OpenSettingsCommand}" />
          <Button Content="{loc:Translate header.disconnectAll}"
                  Command="{Binding DisconnectAllCommand}"
                  IsEnabled="{Binding HasActiveConnections}" />
        </StackPanel>

      </Grid>
    </Border>

    <!--
      What is missing, before anything is attempted. A client that starts perfectly and then ends
      the process the moment somebody presses connect is not reporting a missing dependency, it is
      hiding one.
    -->
    <StackPanel Grid.Row="1">

    <Border Padding="18,12"
            Background="{DynamicResource StateFailedSoft}"
            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
            IsVisible="{Binding IsEnvironmentBlocked}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Grid.Column="0" Spacing="5">
          <TextBlock Text="{loc:Translate environment.title}" FontSize="13" FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource StateFailed}" />
          <TextBlock Text="{Binding EnvironmentProblems}" FontSize="12" TextWrapping="Wrap"
                     Foreground="{DynamicResource StateFailed}" />
          <TextBlock Text="{loc:Translate environment.hint}" FontSize="12" TextWrapping="Wrap"
                     Foreground="{DynamicResource StateFailed}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="8" VerticalAlignment="Center">
          <Button Name="OpenVpnDownloadButton" Content="{loc:Translate environment.download}"
                  MinWidth="150" HorizontalContentAlignment="Center" />
          <Button Content="{loc:Translate environment.recheck}" Classes="quiet"
                  MinWidth="150" HorizontalContentAlignment="Center"
                  Command="{Binding RecheckEnvironmentCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!--
      The shared library: what stands in the way of it, or what reconciling it resolved. Red for the
      first, because changes may be waiting; the accent for the second, because nothing is.
    -->
    <Border Padding="18,12"
            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
            Classes="libraryBanner"
            Classes.problem="{Binding IsLibraryProblem}"
            IsVisible="{Binding IsLibraryBannerVisible}">
      <Border.Styles>
        <!-- Both colours come from styles: a value set on the element would outrank either. -->
        <Style Selector="Border.libraryBanner">
          <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
        </Style>
        <Style Selector="Border.libraryBanner.problem">
          <Setter Property="Background" Value="{DynamicResource StateFailedSoft}" />
        </Style>
      </Border.Styles>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="{loc:Translate library.bannerTitle}" FontSize="13" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}" />
          <TextBlock Text="{Binding LibraryBannerText}" FontSize="12" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextSecondary}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="{loc:Translate library.enterPassphrase}" Classes="primary"
                  IsVisible="{Binding LibraryBannerOffersPassphrase}"
                  Command="{Binding EnterLibraryPassphraseCommand}" />
          <Button Content="{loc:Translate library.retry}"
                  IsVisible="{Binding LibraryBannerOffersRetry}"
                  Command="{Binding RetryLibraryCommand}" />
          <Button Content="{loc:Translate library.restoreDeleted}" Classes="primary"
                  IsVisible="{Binding LibraryBannerOffersDecision}"
                  Command="{Binding RestoreLibraryDeletionsCommand}" />
          <Button Content="{loc:Translate library.confirmDeletion}" Classes="danger"
                  IsVisible="{Binding LibraryBannerOffersDecision}"
                  Command="{Binding ConfirmLibraryDeletionsCommand}" />
          <Button Content="{loc:Translate library.dismiss}" Classes="quiet"
                  Command="{Binding DismissLibraryBannerCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!--
      A newer release, when the user asked to be told. Dismissible, because being told once is
      enough until the next start.
    -->
    <Border Padding="18,12"
            Background="{DynamicResource AccentSoft}"
            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
            IsVisible="{Binding IsUpdateAvailable}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <TextBlock Grid.Column="0" Text="{Binding UpdateMessage}" FontSize="12.5"
                   TextWrapping="Wrap" VerticalAlignment="Center"
                   Foreground="{DynamicResource Accent}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Name="UpdateDownloadButton" Content="{loc:Translate update.download}"
                  MinWidth="130" HorizontalContentAlignment="Center" />
          <Button Content="{loc:Translate update.dismiss}" Classes="quiet"
                  Command="{Binding DismissUpdateCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    </StackPanel>

    <!--
      The detail column can be dragged wider. It is a fixed width by default because that is the
      right size for most of what it holds, and a profile name is free text: someone whose names run
      to sixty characters needs the column to give, not the text to be cut.
    -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="228" />
        <ColumnDefinition Width="*" MinWidth="260" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="352" MinWidth="280" MaxWidth="640" />
      </Grid.ColumnDefinitions>

      <!-- Sidebar -->
      <Border Grid.Column="0" Background="{DynamicResource SurfaceSidebar}"
              BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,1,0">
        <ScrollViewer>
          <StackPanel Margin="12,16" Spacing="18">

            <StackPanel Spacing="6">
              <TextBlock Text="{loc:Translate nav.library}" Classes="overline" Margin="10,0,0,2" />
              <ListBox Classes="nav" ItemsSource="{Binding Filters}"
                       SelectedItem="{Binding SelectedBuiltIn}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SidebarFilterViewModel">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="13"
                                 Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                 Text="{Binding Count, Converter={x:Static conv:AppConverters.CountBadge}}"
                                 FontSize="11" Foreground="{DynamicResource TextTertiary}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding HasTags}">
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="10,0,0,2">
                <TextBlock Text="{loc:Translate nav.tags}" Classes="overline" VerticalAlignment="Center" />
                <Border Classes="hint" ToolTip.Tip="{loc:Translate tags.help}">
                  <TextBlock Text="i" />
                </Border>
              </StackPanel>
              <ListBox Classes="nav" ItemsSource="{Binding TagFilters}"
                       SelectedItem="{Binding SelectedTag}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SidebarFilterViewModel">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="13"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                 Text="{Binding Count, Converter={x:Static conv:AppConverters.CountBadge}}"
                                 FontSize="11" Foreground="{DynamicResource TextTertiary}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Profile list -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">

        <!--
          What the list is showing, and the switch that puts a checkbox on every row. The switch sits
          here rather than in the header because it acts on this list and on nothing else, and it
          says what pressing it again will do: a button that only ever reads "select" gave no sign
          that it had done anything, or of how to leave the mode it had entered.
        -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="20,12,14,2">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectedFilter.Label}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Text="{Binding VisibleSummary}" Classes="muted" VerticalAlignment="Center" />
          </StackPanel>
          <Button Grid.Column="1" Classes="quiet" Classes.primary="{Binding IsSelecting}"
                  Content="{Binding SelectToggleLabel}"
                  ToolTip.Tip="{loc:Translate select.modeHint}"
                  Command="{Binding ToggleSelectingCommand}" />
        </Grid>

        <ListBox Grid.Row="1" Classes="profiles" ItemsSource="{Binding VisibleProfiles}"
                 SelectedItem="{Binding SelectedProfile}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ProfileItemViewModel">
              <Border Padding="14,12" CornerRadius="10" Background="Transparent">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">

                  <CheckBox Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center"
                            IsVisible="{Binding IsSelecting}"
                            IsChecked="{Binding IsSelected}" />

                  <Border Grid.Column="1" Width="8" Height="8" CornerRadius="4"
                          Margin="0,0,14,0" VerticalAlignment="Center"
                          Background="{Binding Status.State, Converter={x:Static conv:AppConverters.StateBrush}}" />

                  <!--
                    Grids, not stacks. A stack panel measures its children with unlimited width in
                    the direction it stacks, so a name inside one is never trimmed however narrow
                    the row gets: it simply runs on past the edge. The name therefore sits in the
                    one column that stretches and everything beside it in a column of its own, and
                    the name is what gives.
                  -->
                  <!--
                    The point below the text is what centres everything beside it. A line box
                    reserves room above the capitals for accents and below the baseline for
                    descenders, and the first line here has more of the one than the last line has of
                    the other, so the ink of the two lines sits half a point below the middle of the
                    block that holds them. Centring on the block therefore reads as too high, which
                    is measurable: the status point and the badges sat a device pixel above the
                    middle of the text and the star a pixel and a half. The point restores the
                    balance, and with it they sit on the middle of the text rather than beside it.
                  -->
                  <StackPanel Grid.Column="2" Spacing="3" Margin="0,0,0,1">
                    <TextBlock Text="{Binding Name}"
                               FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Name}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                      <TextBlock Grid.Column="0" Text="{Binding Endpoint}" Classes="muted" />
                      <TextBlock Grid.Column="1" Text="{Binding TagsDisplay}" Classes="muted"
                                 Foreground="{DynamicResource TextTertiary}"
                                 IsVisible="{Binding HasTags}"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding TagsDisplay}" />
                    </Grid>
                  </StackPanel>

                  <!--
                    What is said about the entry rather than about its name sits in the row itself,
                    the way the status dot on the left does, and only there can it be centred on the
                    two lines instead of on the first of them.
                  -->
                  <!--
                    The gap belongs to each badge rather than to the panel that holds them, so a row
                    with no badge at all takes no width here and the name keeps it.
                  -->
                  <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Classes="slot" Margin="7,0,0,0" IsVisible="{Binding HasFavouriteSlot}">
                      <TextBlock Text="{Binding FavouriteSlotDisplay}" />
                    </Border>
                  </StackPanel>

                  <!--
                    The stroke is the marker's own colour and only rounds the tips, which a five
                    point star at this size needs to stop reading as a set of needles.
                  -->
                  <Path Grid.Column="4" Data="{StaticResource FavouriteStar}"
                        Width="13" Height="13" Stretch="Uniform"
                        Margin="7,0,8,0" VerticalAlignment="Center"
                        Fill="{DynamicResource StatePending}"
                        Stroke="{DynamicResource StatePending}"
                        StrokeThickness="1.1" StrokeJoin="Round" StrokeLineCap="Round"
                        IsVisible="{Binding IsFavourite}" />

                  <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8"
                              VerticalAlignment="Center">
                    <TextBlock Text="!" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource StatePending}"
                               ToolTip.Tip="{loc:Translate profile.unsupportedTooltip}"
                               IsVisible="{Binding HasUnsupportedOptions}" />
                    <Border Classes="pill" IsVisible="{Binding !IsIdle}"
                            Background="{Binding Status.State, Converter={x:Static conv:AppConverters.StatePillBackground}}">
                      <TextBlock Text="{Binding StatusText}"
                                 Foreground="{Binding Status.State, Converter={x:Static conv:AppConverters.StatePillForeground}}" />
                    </Border>
                  </StackPanel>

                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                    MaxWidth="340" IsVisible="{Binding !VisibleProfiles.Count}">
          <TextBlock Text="{Binding EmptyStateTitle}" FontSize="14" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding EmptyStateDetail}" Classes="muted"
                     TextWrapping="Wrap" TextAlignment="Center" />
          <Button Content="{loc:Translate header.import}" Classes="primary"
                  HorizontalAlignment="Center" Margin="0,6,0,0"
                  Command="{Binding OpenImportCommand}" />
        </StackPanel>

        <!--
          What is ticked, and what can be done with it. Two lines: the first says how much is ticked
          and changes that, the second acts on it. Deleting stands apart at the far end and in red,
          and asks twice, because it is the one action here that cannot be undone and the one most
          likely to be aimed at twenty rows.
        -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceSidebar}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0"
                Padding="14,10" IsVisible="{Binding IsSelecting}">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Text="{Binding SelectionSummary}" Classes="muted"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button Content="{loc:Translate select.all}" Classes="quiet"
                        Command="{Binding TickAllShownCommand}" />
                <Button Content="{loc:Translate select.none}" Classes="quiet"
                        IsEnabled="{Binding HasTicked}"
                        Command="{Binding TickNoneCommand}" />
              </StackPanel>
            </Grid>

            <DockPanel LastChildFill="True">
              <Button DockPanel.Dock="Right" Classes="danger" Margin="8,0,0,0"
                      VerticalAlignment="Top"
                      Content="{loc:Translate select.delete}"
                      IsEnabled="{Binding HasTicked}"
                      Command="{Binding AskToDeleteTickedCommand}" />
              <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                <Button Content="{loc:Translate select.connect}" Classes="primary"
                        IsEnabled="{Binding HasTicked}"
                        Command="{Binding ConnectTickedCommand}" />
                <Button Content="{loc:Translate select.disconnect}"
                        IsEnabled="{Binding HasTicked}"
                        Command="{Binding DisconnectTickedCommand}" />
              </WrapPanel>
            </DockPanel>

            <Border CornerRadius="7" Padding="12,10"
                    Background="{DynamicResource StateFailedSoft}"
                    IsVisible="{Binding IsConfirmingDelete}">
              <StackPanel Spacing="9">
                <TextBlock Text="{Binding DeleteConfirmation}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource StateFailed}" />
                <TextBlock Text="{loc:Translate library.deleteSharedNotice}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextPrimary}"
                           IsVisible="{Binding IsLibraryShared}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                  <Button Content="{loc:Translate common.cancel}" Classes="quiet"
                          Command="{Binding CancelDeleteCommand}" />
                  <Button Content="{loc:Translate select.deleteConfirm}" Classes="destructive"
                          Command="{Binding DeleteTickedCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </Grid>

      <GridSplitter Grid.Column="2" Width="5" ResizeDirection="Columns"
                    Background="Transparent" />

      <!--
        Detail. Horizontal scrolling is switched off deliberately: a scroll viewer that allows it
        measures its content with unlimited width, and text that is measured without a limit neither
        wraps nor trims. That is how a long name came to run past the edge of the panel into nothing.
      -->
      <Border Grid.Column="3" Background="{DynamicResource SurfaceSidebar}"
              BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1,0,0,0">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="20" Spacing="18" IsVisible="{Binding HasSelection}">

            <StackPanel Spacing="8">
              <TextBlock Text="{Binding SelectedProfile.Name}" Classes="title"
                         TextWrapping="Wrap"
                         ToolTip.Tip="{Binding SelectedProfile.Name}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="{Binding SelectedProfile.Endpoint}" Classes="muted"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding SelectedProfile.Endpoint}"
                           VerticalAlignment="Center" />
                <Border Grid.Column="1" Classes="pill" VerticalAlignment="Center"
                        Background="{Binding SelectedProfile.Status.State, Converter={x:Static conv:AppConverters.StatePillBackground}}">
                  <TextBlock Text="{Binding SelectedProfile.StatusLabel}"
                             Foreground="{Binding SelectedProfile.Status.State, Converter={x:Static conv:AppConverters.StatePillForeground}}" />
                </Border>
              </Grid>
            </StackPanel>

            <!--
              Wrapping, not a row. The panel is a fixed width and the labels are translated, so a
              row can only ever be as good as the longest translation somebody has not written yet.
              A button that runs off the edge is worse than one on a second line.
            -->
            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
              <Button Content="{loc:Translate profile.connect}" Classes="primary" MinWidth="106"
                      IsVisible="{Binding SelectedProfile.IsIdle}"
                      Command="{Binding ConnectCommand}"
                      CommandParameter="{Binding SelectedProfile}" />
              <Button Content="{loc:Translate profile.disconnect}" MinWidth="106"
                      IsVisible="{Binding !SelectedProfile.IsIdle}"
                      Command="{Binding DisconnectCommand}"
                      CommandParameter="{Binding SelectedProfile}" />
              <Button Content="{Binding SelectedProfile.FavouriteActionLabel}" Classes="quiet"
                      Command="{Binding ToggleFavouriteCommand}"
                      CommandParameter="{Binding SelectedProfile}" />
              <Button Content="{loc:Translate profile.edit}" Classes="quiet"
                      Command="{Binding OpenProfileEditorCommand}" />
              <Button Content="{loc:Translate profile.signInAgain}" Classes="quiet"
                      ToolTip.Tip="{loc:Translate profile.signInAgainHint}"
                      IsVisible="{Binding SelectedProfile.RequiresCredentials}"
                      Command="{Binding SignInAgainCommand}"
                      CommandParameter="{Binding SelectedProfile}" />
              <Button Content="{loc:Translate profile.delete}" Classes="danger"
                      IsVisible="{Binding !IsConfirmingProfileDelete}"
                      Command="{Binding AskToDeleteSelectedCommand}" />
            </WrapPanel>

            <!--
              Asked here, beside the button, rather than in a dialog. Removing one profile from the
              detail panel is a deliberate act on the profile being looked at, and the question names
              it so that nobody deletes the wrong one because the selection moved.
            -->
            <Border CornerRadius="7" Padding="12,10"
                    Background="{DynamicResource StateFailedSoft}"
                    IsVisible="{Binding IsConfirmingProfileDelete}">
              <StackPanel Spacing="9">
                <TextBlock Text="{Binding ProfileDeleteConfirmation}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource StateFailed}" />
                <TextBlock Text="{loc:Translate library.deleteSharedNotice}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextPrimary}"
                           IsVisible="{Binding IsLibraryShared}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                  <Button Content="{loc:Translate common.cancel}" Classes="quiet"
                          Command="{Binding CancelDeleteSelectedCommand}" />
                  <Button Content="{loc:Translate profile.deleteConfirmButton}" Classes="destructive"
                          Command="{Binding DeleteSelectedCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="divider" />

            <StackPanel Spacing="14" IsVisible="{Binding SelectedProfile.IsConnected}">
              <Grid ColumnDefinitions="*,*,*">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="{loc:Translate profile.received}" Classes="overline" />
                  <TextBlock Classes="body" FontSize="15" FontWeight="SemiBold"
                             Text="{Binding SelectedProfile.Status.BytesReceived, Converter={x:Static conv:AppConverters.ByteSize}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Text="{loc:Translate profile.sent}" Classes="overline" />
                  <TextBlock Classes="body" FontSize="15" FontWeight="SemiBold"
                             Text="{Binding SelectedProfile.Status.BytesSent, Converter={x:Static conv:AppConverters.ByteSize}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="3">
                  <TextBlock Text="{loc:Translate profile.uptime}" Classes="overline" />
                  <TextBlock Classes="body" FontSize="15" FontWeight="SemiBold"
                             Text="{Binding SelectedProfile.UptimeDisplay}" />
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="*,2*">
                <StackPanel Grid.Column="0" Spacing="3"
                            ToolTip.Tip="{Binding SelectedProfile.PingTooltip}">
                  <TextBlock Text="{loc:Translate profile.ping}" Classes="overline" />
                  <TextBlock Classes="body" Text="{Binding SelectedProfile.PingDisplay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3"
                            IsVisible="{Binding SelectedProfile.HasPushedOptions}">
                  <TextBlock Text="{loc:Translate profile.dns}" Classes="overline" />
                  <TextBlock Classes="body" TextWrapping="Wrap"
                             Text="{Binding SelectedProfile.DnsDisplay}" />
                </StackPanel>
              </Grid>

              <StackPanel Spacing="3" IsVisible="{Binding SelectedProfile.HasPushedOptions}">
                <TextBlock Text="{loc:Translate profile.routes}" Classes="overline" />
                <TextBlock Classes="body" FontFamily="Consolas,Menlo,monospace" FontSize="11.5"
                           TextWrapping="Wrap" Text="{Binding SelectedProfile.RoutesDisplay}" />
              </StackPanel>

              <Border CornerRadius="7" Padding="12,10"
                      Background="{DynamicResource StatePendingSoft}"
                      IsVisible="{Binding SelectedProfile.HasRefusedDefaultRoute}">
                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource StatePending}"
                           Text="{loc:Translate profile.defaultRouteRefused}" />
              </Border>

              <Border Classes="divider" />
            </StackPanel>

            <!--
              Every value wraps. The labels are translated and the values are free text or an
              address of unknown length, so a row that only fits the English label and a short
              address is a row that will eventually be too narrow for somebody.
            -->
            <StackPanel Spacing="11">
              <Grid ColumnDefinitions="104,*" ColumnSpacing="12">
                <TextBlock Grid.Column="0" Text="{loc:Translate profile.localAddress}" Classes="muted"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Classes="body" TextWrapping="Wrap"
                           Text="{Binding SelectedProfile.LocalAddressDisplay}" />
              </Grid>
              <Grid ColumnDefinitions="104,*" ColumnSpacing="12">
                <TextBlock Grid.Column="0" Text="{loc:Translate profile.server}" Classes="muted"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Classes="body" TextWrapping="Wrap"
                           Text="{Binding SelectedProfile.ServerDisplay}" />
              </Grid>
              <Grid ColumnDefinitions="104,*" ColumnSpacing="12">
                <TextBlock Grid.Column="0" Text="{loc:Translate profile.signIn}" Classes="muted"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Classes="body" TextWrapping="Wrap"
                           Text="{Binding SelectedProfile.AuthenticationDisplay}" />
              </Grid>
              <Grid ColumnDefinitions="104,*" ColumnSpacing="12">
                <TextBlock Grid.Column="0" Text="{loc:Translate profile.lastUsed}" Classes="muted"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Classes="body" TextWrapping="Wrap"
                           Text="{Binding SelectedProfile.LastConnectedDisplay}" />
              </Grid>
              <Grid ColumnDefinitions="104,*" ColumnSpacing="12"
                    IsVisible="{Binding SelectedProfile.HasTags}">
                <TextBlock Grid.Column="0" Text="{loc:Translate nav.tags}" Classes="muted"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Classes="body" TextWrapping="Wrap"
                           Text="{Binding SelectedProfile.TagsDisplay}" />
              </Grid>
              <!--
                Selectable, because what people write here is usually something to copy: a contact,
                an address behind the tunnel, the reason a profile exists.
              -->
              <Grid ColumnDefinitions="104,*" ColumnSpacing="12"
                    IsVisible="{Binding SelectedProfile.HasNotes}">
                <TextBlock Grid.Column="0" Text="{loc:Translate profile.notes}" Classes="muted"
                           TextWrapping="Wrap" />
                <SelectableTextBlock Grid.Column="1" Classes="body" TextWrapping="Wrap"
                                     FontSize="13" Foreground="{DynamicResource TextPrimary}"
                                     Text="{Binding SelectedProfile.Notes}" />
              </Grid>
            </StackPanel>

            <!--
              Outside the block that only appears while a tunnel is up. This is the explanation for
              a tunnel that never comes up at all, so showing it only once connected would be
              showing it only when it is not needed.
            -->
            <Border CornerRadius="7" Padding="12,10"
                    Background="{DynamicResource StateFailedSoft}"
                    IsVisible="{Binding SelectedProfile.HasRefusedCompression}">
              <TextBlock TextWrapping="Wrap" FontSize="12"
                         Foreground="{DynamicResource StateFailed}"
                         Text="{loc:Translate profile.compressionRefused}" />
            </Border>

            <Border CornerRadius="7" Padding="12,10"
                    Background="{DynamicResource StatePendingSoft}"
                    IsVisible="{Binding SelectedProfile.HasUnsupportedOptions}">
              <TextBlock TextWrapping="Wrap" FontSize="12"
                         Foreground="{DynamicResource StatePending}"
                         Text="{loc:Translate profile.unsupportedNotice}" />
            </Border>

            <Border CornerRadius="7" Padding="12,10"
                    Background="{DynamicResource StateFailedSoft}"
                    IsVisible="{Binding SelectedProfile.HasFailureMessage}">
              <TextBlock TextWrapping="Wrap" FontSize="12"
                         Foreground="{DynamicResource StateFailed}"
                         Text="{Binding SelectedProfile.FailureMessage}" />
            </Border>

          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="3" Background="{DynamicResource SurfaceSidebar}"
            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0"
            Padding="18,8">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <!--
          Where the shared library stands, always in view while there is one, so a change can be
          seen being synchronised. The whole sentence is in the tooltip.
        -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" Margin="0,0,18,0"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsLibraryShared}"
                    ToolTip.Tip="{Binding LibraryStateDetail}">
          <StackPanel.Styles>
            <Style Selector="Border.libraryDot">
              <Setter Property="Background" Value="{DynamicResource StateConnected}" />
            </Style>
            <Style Selector="Border.libraryDot.retrying">
              <Setter Property="Background" Value="{DynamicResource StatePending}" />
            </Style>
            <Style Selector="Border.libraryDot.stuck">
              <Setter Property="Background" Value="{DynamicResource StateFailed}" />
            </Style>
            <Style Selector="Border.libraryDot.syncing">
              <Setter Property="Background" Value="{DynamicResource Accent}" />
              <Style.Animations>
                <Animation Duration="0:0:0.7" IterationCount="Infinite" PlaybackDirection="Alternate">
                  <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1" />
                  </KeyFrame>
                  <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0.25" />
                  </KeyFrame>
                </Animation>
              </Style.Animations>
            </Style>
          </StackPanel.Styles>
          <Border Width="7" Height="7" CornerRadius="4" VerticalAlignment="Center"
                  Classes="libraryDot"
                  Classes.syncing="{Binding IsLibrarySyncing}"
                  Classes.retrying="{Binding IsLibraryRetrying}"
                  Classes.stuck="{Binding IsLibraryStuck}" />
          <TextBlock Text="{Binding LibraryStateText}" Classes="muted" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Classes="muted"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                    IsVisible="{Binding HasActiveConnections}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="{loc:Translate profile.received}" Classes="overline"
                       VerticalAlignment="Center" />
            <TextBlock Classes="muted" VerticalAlignment="Center"
                       Text="{Binding TotalBytesReceived, Converter={x:Static conv:AppConverters.ByteSize}}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="{loc:Translate profile.sent}" Classes="overline"
                       VerticalAlignment="Center" />
            <TextBlock Classes="muted" VerticalAlignment="Center"
                       Text="{Binding TotalBytesSent, Converter={x:Static conv:AppConverters.ByteSize}}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <Border Width="7" Height="7" CornerRadius="4" VerticalAlignment="Center"
                    Background="{DynamicResource StateConnected}" />
            <TextBlock Text="{Binding ActiveSummary}" Classes="muted" />
          </StackPanel>
        </StackPanel>

        <!-- The record of what the shared library did, opened from the far end of the bar. -->
        <Button Grid.Column="3" Classes="quiet" Margin="14,-4,-8,-4" Padding="8,3"
                Content="{loc:Translate library.activityButton}"
                IsVisible="{Binding IsLibraryShared}">
          <Button.Flyout>
            <Flyout Placement="TopEdgeAlignedRight">
              <StackPanel Width="480" Spacing="8">
                <TextBlock Text="{loc:Translate library.activityTitle}" Classes="overline" />
                <TextBlock Text="{loc:Translate library.activityEmpty}" Classes="muted"
                           IsVisible="{Binding !HasLibraryActivity}" />
                <ScrollViewer MaxHeight="340" IsVisible="{Binding HasLibraryActivity}">
                  <ItemsControl ItemsSource="{Binding LibraryActivity}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LibraryActivityViewModel">
                        <Grid ColumnDefinitions="72,*" Margin="0,2">
                          <TextBlock Grid.Column="0" Text="{Binding Time}" Classes="muted" FontSize="12" />
                          <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12" TextWrapping="Wrap"
                                     Foreground="{DynamicResource TextPrimary}"
                                     IsVisible="{Binding !IsProblem}" />
                          <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12" TextWrapping="Wrap"
                                     Foreground="{DynamicResource StateFailed}"
                                     IsVisible="{Binding IsProblem}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>

  </Grid>
</Window>
