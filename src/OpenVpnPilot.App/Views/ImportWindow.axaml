<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenVpnPilot.App.ViewModels"
        xmlns:loc="using:OpenVpnPilot.App.Localization"
        x:Class="OpenVpnPilot.App.Views.ImportWindow"
        x:DataType="vm:ImportViewModel"
        Width="820" Height="620"
        MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceWindow}"
        Icon="/Assets/openvpnpilot.ico"
        Title="{loc:Translate header.import}">

  <Grid RowDefinitions="Auto,*,Auto,Auto">

    <Border Grid.Row="0" Background="{DynamicResource SurfaceSidebar}"
            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
            Padding="16,12">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Name="PickFilesButton" Content="{loc:Translate import.pickFiles}" />
        <Button Name="PickFolderButton" Content="{loc:Translate import.pickFolder}" />
        <CheckBox Content="{loc:Translate import.includeSubfolders}"
                  IsChecked="{Binding IncludeSubfolders}"
                  VerticalAlignment="Center" Margin="8,0,0,0" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Rows}" Margin="16,12">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ImportRowViewModel">
              <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                <Border Grid.Column="0" Classes="pill" Margin="0,0,12,0" VerticalAlignment="Top"
                        Background="{DynamicResource SurfaceCardHover}">
                  <TextBlock Text="{Binding OutcomeDisplay}"
                             Foreground="{DynamicResource TextSecondary}" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="{Binding Name}" Classes="body" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Endpoint}" Classes="muted" />
                  <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap"
                             Foreground="{DynamicResource StatePending}"
                             IsVisible="{Binding HasDetail}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                  MaxWidth="360" IsVisible="{Binding !HasRows}">
        <TextBlock Text="{Binding DropHint}" Classes="muted"
                   TextWrapping="Wrap" TextAlignment="Center"
                   IsVisible="{Binding !IsPackage}" />
      </StackPanel>

      <!--
        A package is encrypted, so there is nothing to preview: the screen asks for the passphrase
        and reports what came out of it afterwards.
      -->
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                  MaxWidth="420" IsVisible="{Binding IsPackage}">
        <TextBlock Text="{loc:Translate import.packageTitle}" Classes="title"
                   HorizontalAlignment="Center" />
        <TextBlock Text="{Binding PackageName}" Classes="body" HorizontalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{loc:Translate import.packageHint}" Classes="muted"
                   TextWrapping="Wrap" TextAlignment="Center" />
        <TextBox Text="{Binding Passphrase}" PasswordChar="&#x2022;"
                 PlaceholderText="{loc:Translate export.passphrase}" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0"
            Padding="16,12" IsVisible="{Binding !IsPackage}">
      <Grid ColumnDefinitions="Auto,Auto,*">
        <TextBlock Grid.Column="0" Classes="muted" VerticalAlignment="Center"
                   Text="{loc:Translate import.tags}" Margin="0,0,6,0" />
        <Border Grid.Column="1" Classes="hint" Margin="0,0,10,0"
                ToolTip.Tip="{loc:Translate tags.help}">
          <TextBlock Text="i" />
        </Border>
        <TextBox Grid.Column="2" Text="{Binding TagsInput}"
                 PlaceholderText="{loc:Translate import.tagsHint}" />
      </Grid>
    </Border>

    <Border Grid.Row="3" Background="{DynamicResource SurfaceSidebar}"
            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0"
            Padding="16,12">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Classes="muted"
                   VerticalAlignment="Center" TextWrapping="Wrap" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <!-- Return imports, which is what typing a passphrase is followed by; escape closes. -->
          <Button Content="{loc:Translate common.cancel}" MinWidth="96" IsCancel="True"
                  Command="{Binding CancelCommand}" />
          <Button Content="{loc:Translate import.commit}" Classes="primary" MinWidth="120"
                  IsDefault="True"
                  Command="{Binding CommitCommand}"
                  IsEnabled="{Binding CanCommit}" />
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</Window>
