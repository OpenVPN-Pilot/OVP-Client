<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenVpnPilot.App.ViewModels"
        xmlns:loc="using:OpenVpnPilot.App.Localization"
        x:Class="OpenVpnPilot.App.Views.CredentialPromptWindow"
        x:DataType="vm:CredentialPromptViewModel"
        Title="{Binding Title}"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceWindow}"
        Icon="/Assets/openvpnpilot.ico">

  <StackPanel Margin="24" Spacing="14">

    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
               Foreground="{DynamicResource TextPrimary}" />

    <Border Background="{DynamicResource StateFailedSoft}"
            CornerRadius="{StaticResource RadiusMedium}" Padding="10,7"
            IsVisible="{Binding IsRetry}">
      <TextBlock Text="{loc:Translate credentials.rejected}"
                 Foreground="{DynamicResource StateFailed}"
                 TextWrapping="Wrap" FontSize="12" />
    </Border>

    <StackPanel Spacing="5" IsVisible="{Binding NeedsUsername}">
      <TextBlock Text="{loc:Translate credentials.username}" Classes="muted" />
      <TextBox Name="UsernameBox" Text="{Binding Username}" />
    </StackPanel>

    <StackPanel Spacing="5" IsVisible="{Binding NeedsPassword}">
      <TextBlock Text="{loc:Translate credentials.password}" Classes="muted" />
      <TextBox Name="PasswordBox" Text="{Binding Password}" PasswordChar="•" />
    </StackPanel>

    <StackPanel Spacing="5" IsVisible="{Binding HasChallenge}">
      <TextBlock Text="{Binding ChallengeText}" Classes="muted" TextWrapping="Wrap" />
      <TextBox Name="ChallengeBox" Text="{Binding ChallengeResponse}"
               PasswordChar="{Binding ChallengeMask}" />
    </StackPanel>

    <CheckBox Content="{loc:Translate credentials.remember}"
              IsChecked="{Binding Remember}"
              IsVisible="{Binding CanRemember}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
      <Button Content="{loc:Translate common.cancel}" Command="{Binding CancelCommand}" MinWidth="92" />
      <Button Content="{loc:Translate profile.connect}" Command="{Binding ConfirmCommand}"
              MinWidth="92" Classes="primary" IsDefault="True" />
    </StackPanel>

  </StackPanel>
</Window>
