<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenVpnPilot.App.ViewModels"
        x:Class="OpenVpnPilot.App.Views.CredentialPromptWindow"
        x:DataType="vm:CredentialPromptViewModel"
        Title="{Binding Title}"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

  <StackPanel Margin="24" Spacing="14">

    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />

    <Border Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
            CornerRadius="4" Padding="10,7"
            IsVisible="{Binding IsRetry}">
      <TextBlock Text="The previous credentials were refused by the server."
                 TextWrapping="Wrap" FontSize="12" />
    </Border>

    <StackPanel Spacing="5" IsVisible="{Binding NeedsUsername}">
      <TextBlock Text="User name" FontSize="12" Opacity="0.7" />
      <TextBox Text="{Binding Username}" />
    </StackPanel>

    <StackPanel Spacing="5">
      <TextBlock Text="Password" FontSize="12" Opacity="0.7" />
      <TextBox Text="{Binding Password}" PasswordChar="•" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
      <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" />
      <Button Content="Connect" Command="{Binding ConfirmCommand}" MinWidth="90"
              Classes="accent" IsDefault="True" />
    </StackPanel>

  </StackPanel>
</Window>
