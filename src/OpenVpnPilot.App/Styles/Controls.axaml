<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Typography scale. Three sizes and three weights carry the whole interface. -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>

  <Style Selector="TextBlock.overline">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
    <Setter Property="LetterSpacing" Value="0.9" />
  </Style>

  <!-- Buttons: a quiet default and one accented primary. -->
  <Style Selector="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceCardHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.primary /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.quiet">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <!-- Search field and other inputs. -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource SurfaceInput}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    <Setter Property="Padding" Value="11,8" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="34" />
  </Style>

  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>

  <!-- Sidebar entries behave as navigation rather than as a list. -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceCardHover}" />
  </Style>

  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>

  <!-- Profile rows read as cards, with the selection carried by an accent edge. -->
  <Style Selector="ListBox.profiles">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <Style Selector="ListBox.profiles ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ListBox.profiles ListBoxItem /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
  </Style>

  <Style Selector="ListBox.profiles ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceCardHover}" />
  </Style>

  <Style Selector="ListBox.profiles ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>

  <!-- Small status label shown on a row and in the detail panel. -->
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.pill > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <!-- Numbered favourite slot, shown next to the profile name. -->
  <Style Selector="Border.slot">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.slot > TextBlock">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>

  <!-- Section heading inside a settings or history panel. -->
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Margin" Value="0,6,0,2" />
  </Style>

  <!-- Rows of the quick switcher, denser than the main list. -->
  <Style Selector="ListBox.switcher">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
  </Style>

  <Style Selector="ListBox.switcher ListBoxItem">
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ListBox.switcher ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>

  <!-- Tabular listing used by the history and the import preview. -->
  <Style Selector="ListBox.records">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="ListBox.records ListBoxItem">
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource SurfaceInput}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="34" />
  </Style>

  <!-- Separator used between grouped detail rows. -->
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="Margin" Value="0,4" />
  </Style>

</Styles>
