<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The helper is an executable compiled ahead of time when published; tests use it as a library. -->
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenVpnPilot.Platform.MacOS\OpenVpnPilot.Platform.MacOS.csproj" />
    <ProjectReference Include="..\..\src\OpenVpnPilot.Platform.MacOS.Helper\OpenVpnPilot.Platform.MacOS.Helper.csproj" />
    <ProjectReference Include="..\..\src\OpenVpnPilot.Platform.MacOS.Protocol\OpenVpnPilot.Platform.MacOS.Protocol.csproj" />
  </ItemGroup>

</Project>
