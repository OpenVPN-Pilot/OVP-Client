<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      Globalization is deliberately not switched off here, and it was. InvariantGlobalization leaves
      CultureInfo.CurrentUICulture as the invariant culture whose name is the empty string, so the
      language setting "follow the system" resolved to English on a German system, on both platforms,
      and every date and number was formatted the invariant way rather than the reader's. Both
      Windows 10 and macOS carry ICU, so nothing is bundled for this. The helper switches it back on
      for itself: it is a root daemon that formats nothing for anyone.
    -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup>
    <Product>OpenVpnPilot</Product>
    <Company>Schecher_1</Company>
    <Authors>Schecher_1</Authors>
    <Copyright>Copyright (c) 2026 Schecher_1</Copyright>
    <Version>1.4.0</Version>
  </PropertyGroup>

</Project>
